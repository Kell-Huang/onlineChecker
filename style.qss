/* ============ Global ============ */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    color: #1D1D1F;
}

QMainWindow, QWidget#centralWidget {
    background: #F5F5F7;
}

/* ============ Header ============ */
#headerFrame {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E5EA;
}

#titleLabel {
    font-size: 11px;
    font-weight: 600;
    color: #1D1D1F;
    line-height: 1.3;
}

#subtitleLabel {
    font-size: 11px;
    font-weight: 400;
    color: #6E6E73;
    line-height: 1.4;
}

#versionLabel {
    font-size: 11px;
    color: #6E6E73;
}

/* ============ Status Bar ============ */
#statusBarFrame {
    background: #FFFFFF;
    border-top: 1px solid #E5E5EA;
}

#statusLabel {
    font-size: 11px;
    color: #6E6E73;
}

/* ============ Splitter ============ */
QSplitter::handle {
    background: #E5E5EA;
}

QSplitter::handle:hover {
    background: #D1D1D6;
}

/* ============ Cards / Panels ============ */
QFrame[card="true"] {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 12px;
}

QFrame[card="true"]:hover {
    border: 1px solid #D1D1D6;
}

QFrame[card="true"] QLabel[panelTitle="true"] {
    font-size: 12px;
    font-weight: 600;
    color: #1D1D1F;
    line-height: 1.0;
    padding-left: 4px;
    border-left: 2px solid #1D1D1F;
}

/* ============ Buttons ============ */
QPushButton {
    background-color: #1D1D1F;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 3px 8px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3A3A3C;
}

QPushButton:pressed {
    background-color: #1D1D1F;
}

/* FIX: raise disabled-button contrast against the window background */
QPushButton:disabled {
    background-color: #E5E5EA;
    color: #AEAEB2;
}

QPushButton[secondary="true"] {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #E5E5EA;
    padding: 3px 8px;
}

QPushButton[secondary="true"]:hover {
    background-color: #F0F0F2;
}

/* FIX: keep secondary buttons recognizable when disabled */
QPushButton[secondary="true"]:disabled {
    background-color: #FFFFFF;
    color: #C7C7CC;
    border: 1px solid #E5E5EA;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #6E6E73;
    border: none;
    padding: 2px 4px;
    font-weight: 500;
}

QPushButton[flat="true"]:hover {
    color: #1D1D1F;
    background-color: #F0F0F2;
    border-radius: 4px;
}

QPushButton[flat="true"][active="true"] {
    color: #1D1D1F;
    border-bottom: 2px solid #1D1D1F;
    border-radius: 0;
}

/* ============ Inputs / ComboBox ============ */
QLineEdit, QComboBox {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    padding: 2px 5px;
    selection-background-color: #F0F0F2;
    selection-color: #1D1D1F;
}

QLineEdit:hover, QComboBox:hover {
    border: 1px solid #D1D1D6;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #AAAAAA;
}

QLineEdit:disabled, QComboBox:disabled {
    background: #F5F5F7;
    color: #C7C7CC;
}

/* ============ Tables ============ */
QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #FAFAFA;
    gridline-color: #E5E5EA;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
}

QTableWidget::item {
    padding: 3px 6px;
    border: none;
}

QTableWidget::item:hover {
    background: #F5F5F7;
}

QHeaderView::section {
    background: #FAFAFA;
    color: #6E6E73;
    font-size: 11px;
    font-weight: 500;
    border: 1px solid #E5E5EA;
    padding: 3px 6px;
}

QTableWidget::item:selected {
    background: #F0F0F2;
    color: #1D1D1F;
}

/* ============ Lists ============ */
QListWidget {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
}

QListWidget::item {
    padding: 1px 3px;
    min-height: 18px;
    color: #1D1D1F;
}

QListWidget::item:hover {
    background: #F5F5F7;
}

QListWidget::item:selected {
    background: #F0F0F2;
    color: #1D1D1F;
}

/* NEW: QTreeWidget */
QTreeWidget {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    outline: none;
}

QTreeWidget::item {
    padding: 2px 4px;
    min-height: 20px;
    color: #1D1D1F;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background: #F5F5F7;
}

QTreeWidget::item:selected {
    background: #F0F0F2;
    color: #1D1D1F;
}

QTreeWidget::branch {
    background: transparent;
}

/* ============ Log Text Edit ============ */
#logTextEdit {
    background: #F5F5F7;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    padding: 2px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10px;
    color: #4A4A4D;
}

/* NEW: Generic QTextEdit */
QTextEdit {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    padding: 4px;
    color: #1D1D1F;
}

/* ============ Progress Bar ============ */
QProgressBar#progressBar {
    background: #F5F5F7;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    min-height: 18px;
    max-height: 18px;
    text-align: center;
    font-size: 10px;
    color: #6E6E73;
}

QProgressBar#progressBar::chunk {
    background: #1D1D1F;
    border-radius: 7px;
}

QLabel#progressLabel {
    font-size: 10px;
    color: #6E6E73;
}

/* ============ Section Labels ============ */
#sectionLabel {
    font-size: 10px;
    font-weight: 600;
    color: #6E6E73;
}

#hintLabel {
    font-size: 9px;
    color: #6E6E73;
}

#pathLabel {
    font-size: 10px;
    color: #6E6E73;
}

#searchInput {
    padding: 2px 6px;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    background: #FFFFFF;
    font-size: 12px;
    color: #1D1D1F;
}

/* ============ Checkbox ============ */
QCheckBox {
    color: #1D1D1F;
    font-size: 12px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background: transparent;
    border: 1px solid #1D1D1F;
    border-radius: 4px;
    image: url(ui/check.svg);
}

/* ============ Info Panel ============ */
#infoLabel { font-size: 10px; color: #6E6E73; }
#infoValue { font-size: 10px; font-weight: 600; color: #1D1D1F; }
#formulaLabel { font-size: 9px; color: #6E6E73; }

#statusValue {
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: #F5F5F7;
    border-left: 3px solid #6E6E73;
    color: #1D1D1F;
}

#statusValue[status="ready"]   { border-left-color: #27AE60; }
#statusValue[status="running"] { border-left-color: #F39C12; }
#statusValue[status="done"]    { border-left-color: #27AE60; }
#statusValue[status="error"]   { border-left-color: #E74C3C; }

/* ============ Scrollbars ============ */
QScrollBar:vertical {
    background: #F5F5F7;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #C7C7CC;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover { background: #AEAEB2; }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #F5F5F7;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #C7C7CC;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover { background: #AEAEB2; }

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ============ Table Corner & Headers ============ */
QTableWidget::corner {
    background: #FAFAFA;
    border: 1px solid #E5E5EA;
}

QHeaderView {
    background: #FAFAFA;
    border: none;
}

/* ============ Small Buttons ============ */
QPushButton[small="true"] {
    padding: 2px 6px;
    font-size: 11px;
    border-radius: 4px;
}

/* ============ Badges ============ */
QLabel[type="direct"]    { background: #2E7D32; color: #FFFFFF; border-radius: 3px; font-size: 9px; font-weight: bold; }
QLabel[type="indirect"]  { background: #EF6C00; color: #FFFFFF; border-radius: 3px; font-size: 9px; font-weight: bold; }
QLabel[type="new"]       { background: #00838F; color: #FFFFFF; border-radius: 3px; font-size: 9px; font-weight: bold; }
QLabel[type="unmatched"] { background: #C62828; color: #FFFFFF; border-radius: 3px; font-size: 9px; font-weight: bold; }

/* ============ ComboBox Dropdown List ============ */
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    selection-background-color: #F0F0F2;
    selection-color: #1D1D1F;
    outline: none;
}

/* ============ SKU Panel Status Label ============ */
#skuStatusLabel {
    font-size: 11px;
    color: #6E6E73;
}

/* NEW: QDialog */
QDialog {
    background: #F5F5F7;
    border-radius: 12px;
}

QDialog QLabel {
    color: #1D1D1F;
}

/* NEW: QMenu */
QMenu {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
    color: #1D1D1F;
}

QMenu::item:selected {
    background: #F0F0F2;
    color: #1D1D1F;
}

QMenu::separator {
    height: 1px;
    background: #E5E5EA;
    margin: 4px 8px;
}

QMenu::section {
    padding: 4px 12px;
    color: #6E6E73;
    font-size: 10px;
    font-weight: 600;
}

/* NEW: QMessageBox */
QMessageBox { background: #FFFFFF; }
QMessageBox QLabel { color: #1D1D1F; }

/* NEW: QSpinBox */
QSpinBox {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    padding: 2px 5px;
    color: #1D1D1F;
}

QSpinBox:hover { border-color: #D1D1D6; }
QSpinBox:focus { border-color: #AAAAAA; }

QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    width: 14px;
}

QSpinBox::up-arrow, QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* NEW: QGroupBox */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    font-size: 11px;
    font-weight: 600;
    color: #1D1D1F;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    background: #FFFFFF;
    color: #6E6E73;
}

/* NEW: QTabWidget */
QTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #6E6E73;
    padding: 6px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 11px;
    font-weight: 500;
}

QTabBar::tab:hover { color: #1D1D1F; }

QTabBar::tab:selected {
    color: #1D1D1F;
    border-bottom: 2px solid #1D1D1F;
}

/* NEW: QToolTip */
QToolTip {
    background: #1D1D1F;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QComboBox[invalid="true"] { color: #C62828; }